#Diese Felder kannst Du bearbeiten:
APP_NAME="CRM"
APP_URL=https://your-domain.de

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dein_datenbankname
DB_USERNAME=dein_datenbankbenutzer
DB_PASSWORD=dein_datenbankpasswort

MAIL_HOST=dein-smtp-mailserver.de
MAIL_PORT=587
MAIL_USERNAME=dein-smtp-benutzer
MAIL_PASSWORD=dein-smtp-passwort
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@your-domain.de

# Kontaktadresse für OpenStreetMap. Die Nutzungsbedingungen verlangen sie für
# die Adresssuche, ohne sie kann der Dienst den Zugriff sperren.
NOMINATIM_CONTACT=info@your-domain.de

# Unbestätigte Formular-Einsendungen werden nach so vielen Tagen gelöscht.
# Ohne Angabe bleiben sie erhalten.
#FORM_CONFIRMATION_PRUNE_AFTER_DAYS=60

# Diese Felder werden automatisch gesetzt:
APP_ENV=production
APP_KEY=
APP_DEBUG=false
MAIL_FROM_NAME="${APP_NAME}"

NEXTCLOUD_BASE_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# Systemadmin, den php artisan db:seed (auch migrate:fresh --seed) anlegt,
# mit denselben Angaben wie die Registrierung. Ohne E-Mail und Passwort wird keiner angelegt.
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Media (logos, icons, images) in an S3 bucket instead of storage/, e.g. on staging. Production stays local.
# The bucket must allow public reads below the prefix "public". AWS_URL is the public address of the bucket.
MEDIA_DISK_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
